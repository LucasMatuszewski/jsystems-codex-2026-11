{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "dev": "node --env-file-if-exists=../../.env --import tsx src/index.ts"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.163",
    "express": "5.3.0",
    "multer": "2.5.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "6.0.3"
  }
}
